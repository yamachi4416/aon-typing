{
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.18.0",
  "browserslist": [
    "since 2023-03-01 and not Firefox < 121"
  ],
  "scripts": {
    "postinstall": "nuxt prepare",
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "lint": "pnpm run '/lint:.*/'",
    "lint:knip": "knip",
    "lint:typecheck": "nuxt typecheck",
    "lint:scripts": "eslint .",
    "lint:styles": "stylelint app/**/*.{scss,vue}",
    "test": "vitest",
    "test:unit": "vitest --project unit --project app:nuxt --project app:browser",
    "test:e2e": "vitest --project e2e",
    "script:preview:dist": "node --experimental-transform-types ./scripts/preview-server.ts -d ./dist",
    "script:problem": "node --experimental-transform-types ./scripts/problem.ts",
    "script:problem:generate": "node --experimental-transform-types ./scripts/problem.ts generate -i ./data -o ./app/assets/api"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/seo": "^6.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-legacy": "^8.2.4",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/test-utils": "^2.5.1",
    "citty": "^0.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "google-fonts-helper": "^3.7.4",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.2",
    "nuxt": "^4.6.4",
    "playwright": "^1.65.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-browser-compat": "1.0.0-beta.180",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-component-type-helpers": "^3.3.14",
    "vue-gtag-next": "^1.14.0",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  }
}
