{
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.17.0",
  "browserslist": [
    "since 2023-03-01 and not Firefox < 121"
  ],
  "scripts": {
    "postinstall": "nuxt prepare",
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "lint": "pnpm run '/lint:.*/'",
    "lint:knip": "knip",
    "lint:typecheck": "nuxt typecheck",
    "lint:scripts": "eslint .",
    "lint:styles": "stylelint app/**/*.{scss,vue}",
    "test": "vitest",
    "test:unit": "vitest --project unit --project app:nuxt --project app:browser",
    "test:e2e": "vitest --project e2e",
    "script:preview:dist": "node --experimental-transform-types ./scripts/preview-server.ts -d ./dist",
    "script:problem": "node --experimental-transform-types ./scripts/problem.ts",
    "script:problem:generate": "node --experimental-transform-types ./scripts/problem.ts generate -i ./data -o ./app/assets/api"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/seo": "^5.3.6",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/test-utils": "^2.4.11",
    "citty": "^0.2.2",
    "defu": "^6.1.7",
    "eslint": "^10.7.0",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-promise": "^7.3.0",
    "google-fonts-helper": "^3.7.4",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "nuxt": "^4.5.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17.14.1",
    "stylelint-browser-compat": "1.0.0-beta.180",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-component-type-helpers": "^3.3.8",
    "vue-gtag-next": "^1.14.0",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.8"
  }
}
